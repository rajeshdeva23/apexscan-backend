.env
.env.*
!.env.example
credentials/
*.pem
*.key

# Local build/editor files
*.local

# Editors / OS
.idea/
.vscode/
.claude/settings.local.json
.DS_Store
Thumbs.db

# Docker / data volumes
docker/postgres/data/
*.pid

# Logs
logs/
*.log

# Alembic scratch
backend/alembic/versions/__pycache__/
