# ---------------------------------------------------------------------------
# ApexScan — Example environment configuration
# Copy this file to `.env` and adjust values per environment.
# NEVER commit the real `.env` file. Secrets stay out of version control.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=ApexScan
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Backend server --------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for the browser frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=apexscan
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=apexscan
POSTGRES_HOST=postgres         # service name inside docker-compose network
POSTGRES_PORT=5432
# Async SQLAlchemy URL (asyncpg driver) — composed from the values above.
DATABASE_URL=postgresql+asyncpg://apexscan:change_me_in_local_env@postgres:5432/apexscan

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis               # service name inside docker-compose network
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Frontend --------------------------------------------------------------
# Base URL the React app uses to reach the backend API (Vite env var).
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
