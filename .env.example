# ---------------------------------------------------------------------------
# ApexScan — Example environment configuration
# Copy this file to `.env` and adjust values per environment.
# NEVER commit the real `.env` file. Secrets stay out of version control.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=ApexScan
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Backend server --------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for the browser frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=apexscan
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=apexscan
POSTGRES_HOST=postgres         # service name inside docker-compose network
POSTGRES_PORT=5432
# Async SQLAlchemy URL (asyncpg driver) — composed from the values above.
DATABASE_URL=postgresql+asyncpg://apexscan:change_me_in_local_env@postgres:5432/apexscan

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis               # service name inside docker-compose network
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Provider lifecycle ----------------------------------------------------
# Bounds connect, health, and disconnect operations for the configured provider.
# P3.2 does not require provider credentials; a concrete provider is added later.
PROVIDER_LIFECYCLE_TIMEOUT_SECONDS=5

# --- Dhan adapter ---------------------------------------------------------
# Optional for ordinary backend startup and CI. The protected live smoke uses
# the explicit TOTP mode below to generate its short-lived access token at runtime.
# Keep all real Dhan values only in secure environment/secret configuration;
# never commit them. The host clock must remain synchronized for TOTP to work.
DHAN_AUTH_MODE=totp            # totp | access_token
DHAN_CLIENT_ID=replace_with_secure_dhan_client_id
DHAN_PIN=replace_with_secure_six_digit_dhan_pin
DHAN_TOTP_SECRET=replace_with_secure_dhan_totp_secret
# Used only when DHAN_AUTH_MODE=access_token is deliberately selected.
DHAN_ACCESS_TOKEN=replace_with_secure_dhan_access_token
DHAN_REST_BASE_URL=https://api.dhan.co/v2
DHAN_REST_TIMEOUT_SECONDS=10
# Set true only with a separately explicit APEXSCAN_DHAN_LIVE_SMOKE=1 test run.
# The protected smoke validates REST and, during NSE regular market hours, a
# bounded five-instrument standard-feed WebSocket sample using mapped cash equities.
DHAN_LIVE_SMOKE_ENABLED=false
